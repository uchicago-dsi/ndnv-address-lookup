{
  "version": 8,

  "name": "north-dakota-street-address-lookup",
  "id": "north-dakota-street-address-lookup",
  "metadata": {},

  "sources": {
    "google_satellite": {
      "type": "raster",
      "tiles": [
        "https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}"
      ],
      "tileSize": 256,
      "attribution": "<a href='https://maps.google.com/'>Google</a>"
    }
  },

  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#5f6c4c"
      }
    },
    {
      "id": "satellite",
      "type": "raster",
      "source": "google_satellite",
      "maxzoom": 24,
      "layout": {
        "visibility": "visible"
      }
    },
    {
      "id": "states",
      "type": "line",
      "source": "states",
      "paint": {
        "line-color": "hsl(122, 100%, 35%)",
        "line-width": 2
      }
    },
    {
      "id": "counties",
      "type": "line",
      "source": "counties",
      "paint": {
        "line-color": "hsl(122, 100%, 35%)",
        "line-width": 2
      }
    },
    {
      "id": "reservations",
      "type": "line",
      "source": "reservations",
      "paint": {
        "line-color": "hsl(60, 100%, 40%)",
        "line-width": 2
      }
    }
  ]
}
