{
  "version": 8,

  "name": "north-dakota-street-address-lookup",
  "id": "north-dakota-street-address-lookup",
  "metadata": {},

  "sources": {
    "google_satellite": {
      "type": "raster",
      "tiles": [
        "https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}"
      ],
      "tileSize": 256,
      "attribution": "<a target='_blank' href='https://maps.google.com/'>Google Maps</a>"
    },
    "openmaptiles": {
      "type": "vector",
      "tiles": [
        "https://d17gef4m69t9r4.cloudfront.net/planet/{z}/{x}/{y}.mvt"
      ],
      "maxzoom": 14,
      "attribution": "<a href='https://www.openmaptiles.org/'>OpenMapTiles</a>, <a href='https://www.openstreetmap.org/copyright/'>OpenStreetMap contributors</a>"
    }
  },

  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#5f6c4c"
      }
    },
    {
      "id": "counties",
      "type": "line",
      "source": "counties",
      "paint": {
        "line-color": "hsl(122, 100%, 35%)",
        "line-width": 2
      }
    },
    {
      "id": "counties-names",
      "type": "symbol",
      "source": "counties",
      "maxzoom": 9,
      "layout": {
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "base": 1.2,
          "stops": [[7, 14], [11, 24]]
        },
        "text-field": "{name}",
        "text-max-width": 8,
        "visibility": "visible"
      },
      "paint": {
        "text-color": "hsl(122, 100%, 56%)"
      }
    },
    {
      "id": "reservations",
      "type": "line",
      "source": "reservations",
      "paint": {
        "line-color": "hsl(60, 100%, 40%)",
        "line-width": 2
      }
    },
    {
      "id": "reservation-names",
      "type": "symbol",
      "source": "reservations",
      "maxzoom": 9,
      "layout": {
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "base": 1.2,
          "stops": [[7, 14], [11, 24]]
        },
        "text-field": "{name}",
        "text-max-width": 8,
        "visibility": "visible"
      },
      "paint": {
        "text-color": "hsl(60, 100%, 50%)"
      }
    },

    {
      "id": "highway-secondary-tertiary-casing",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "secondary"], ["==", "draw", 1]],
      "minzoom": 8.5,
      "layout": {"line-cap": "butt", "line-join": "round"},
      "paint": {
        "line-color": "#e9ac77",
        "line-opacity": {
          "base": 0.5,
          "stops": [[8.5, 0], [9.5, 0.5], [20, 0.5]]
        },
        "line-width": {
          "base": 1.2,
          "stops": [[8, 1.5], [20, 17]]
        }
      }
    },
    {
      "id": "highway-primary-casing",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "primary"], ["==", "draw", 1]],
      "minzoom": 7,
      "layout": {"line-cap": "butt", "line-join": "round"},
      "paint": {
        "line-color": "#e9ac77",
        "line-opacity": {
          "stops": [[7, 0], [8, 0.6]]
        },
        "line-width": {
          "base": 1.2,
          "stops": [[7, 0], [8, 0.6], [9, 1.5], [20, 22]]
        }
      }
    },
    {
      "id": "highway-trunk-casing",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "trunk"], ["==", "draw", 1]],
      "minzoom": 5,
      "layout": {"line-cap": "butt", "line-join": "round"},
      "paint": {
        "line-color": "#e9ac77",
        "line-opacity": {
          "stops": [[5, 0], [6, 0.5]]
        },
        "line-width": {
          "base": 1.2,
          "stops": [[5, 0], [6, 0.6], [7, 1.5], [20, 22]]
        }
      }
    },
    {
      "id": "highway-motorway-casing",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "motorway"], ["==", "draw", 1]],
      "minzoom": 4,
      "layout": {"line-cap": "butt", "line-join": "round"},
      "paint": {
        "line-color": "#e9ac77",
        "line-opacity": {
          "stops": [[4, 0], [5, 0.5]]
        },
        "line-width": {
          "base": 1.2,
          "stops": [[4, 0], [5, 0.4], [6, 0.6], [7, 1.5], [20, 22]]
        }
      }
    },
    {
      "id": "highway-secondary-tertiary",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "secondary"], ["==", "draw", 1]],
      "minzoom": 8.5,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#fea",
        "line-opacity": {
          "base": 0.5,
          "stops": [[8.5, 0], [9.5, 0.5], [20, 0.5]]
        },
        "line-width": {
          "base": 1.2,
          "stops": [[6.5, 0], [8, 0.5], [20, 13]]
        }
      }
    },
    {
      "id": "highway-primary",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "primary"], ["==", "draw", 1]],
      "minzoom": 8.5,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#fea",
        "line-opacity": 0.5,
        "line-width": {
          "base": 1.2,
          "stops": [[8.5, 0], [9, 0.5], [20, 18]]
        }
      }
    },
    {
      "id": "highway-trunk",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "trunk"], ["==", "draw", 1]],
      "minzoom": 4,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#fea",
        "line-opacity": 0.5,
        "line-width": {
          "base": 1.2,
          "stops": [[4, 0], [7, 0.5], [20, 18]]
        }
      }
    },
    {
      "id": "highway-motorway",
      "type": "line",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "motorway"], ["==", "draw", 1]],
      "minzoom": 4,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#fc8",
        "line-opacity": 0.5,
        "line-width": {
          "base": 1.2,
          "stops": [[4, 0], [7, 0.5], [20, 18]]
        }
      }
    },
    {
      "id": "highway-name-major",
      "type": "symbol",
      "source": "big-roads",
      "filter": ["all", ["in", "fclass", "primary", "secondary", "tertiary", "motorway", "trunk"], ["!=", "name", ""]],
      "minzoom": 12.2,
      "layout": {
        "text-size": {
          "base": 1,
          "stops": [[13, 12], [14, 13]]
        },
        "text-font": ["Noto Sans Regular"],
        "text-field": "{name}",
        "symbol-placement": "line",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "black",
        "text-halo-color": "white",
        "text-halo-blur": 0.5,
        "text-halo-width": 2
      }
    },
    {
      "id": "highway-shield",
      "type": "symbol",
      "source": "big-roads",
      "filter": ["all", [">", "ref_length", 0], ["<=", "ref_length", 7], ["in", "ref_prefix", "CR", "BIA", "FS", "PTH", "PR", "TR", "CH"]],
      "minzoom": 10.5,
      "layout": {
        "text-size": 10,
        "icon-image": "road_{ref_length}",
        "icon-rotation-alignment": "viewport",
        "symbol-spacing": 200,
        "text-font": ["Noto Sans Regular"],
        "symbol-placement": {
          "base": 1,
          "stops": [[10, "point"], [11, "line"]]
        },
        "text-rotation-alignment": "viewport",
        "icon-size": 1,
        "text-field": "{ref_prefix} {ref_rest}"
      },
      "paint": {
        "text-color": "rgba(0, 0, 0, 1)"
      }
    },
    {
      "id": "highway-shield-us-interstate",
      "type": "symbol",
      "source": "big-roads",
      "filter": ["all", [">", "ref_rest_length", 0], ["<=", "ref_rest_length", 3], ["in", "ref_prefix", "I"]],
      "minzoom": 9,
      "layout": {
        "text-size": 10,
        "icon-image": "us-interstate_{ref_rest_length}",
        "icon-rotation-alignment": "viewport",
        "symbol-spacing": 200,
        "text-font": ["Noto Sans Regular"],
        "symbol-placement": {
          "base": 1,
          "stops": [[7, "point"], [7, "line"], [8, "line"]]
        },
        "text-rotation-alignment": "viewport",
        "icon-size": 1,
        "text-field": "{ref_rest}"
      },
      "paint": {
        "text-color": "rgba(0, 0, 0, 1)"
      }
    },
    {
      "id": "highway-shield-us-other",
      "type": "symbol",
      "source": "big-roads",
      "filter": ["all", [">", "ref_rest_length", 0], ["<=", "ref_rest_length", 3], ["in", "ref_prefix", "US"]],
      "minzoom": 9,
      "layout": {
        "text-size": 10,
        "icon-image": "us-highway_{ref_rest_length}",
        "icon-rotation-alignment": "viewport",
        "symbol-spacing": 200,
        "text-font": ["Noto Sans Regular"],
        "symbol-placement": {
          "base": 1,
          "stops": [[10, "point"], [11, "line"]]
        },
        "text-rotation-alignment": "viewport",
        "icon-size": 1,
        "text-field": "{ref_rest}"
      },
      "paint": {
        "text-color": "rgba(0, 0, 0, 1)"
      }
    },
    {
      "id": "highway-shield-us-other-2",
      "type": "symbol",
      "source": "big-roads",
      "filter": ["all", [">", "ref_length", 0], ["<=", "ref_length", 6], ["in", "ref_prefix", "ND", "SD", "MT", "MN"]],
      "minzoom": 9,
      "layout": {
        "text-size": 10,
        "icon-image": "us-state_{ref_length}",
        "icon-rotation-alignment": "viewport",
        "symbol-spacing": 200,
        "text-font": ["Noto Sans Regular"],
        "symbol-placement": {
          "base": 1,
          "stops": [[10, "point"], [11, "line"]]
        },
        "text-rotation-alignment": "viewport",
        "icon-size": 1,
        "text-field": "{ref_prefix} {ref_rest}"
      },
      "paint": {
        "text-color": "rgba(0, 0, 0, 1)"
      }
    }

  ]
}
